{
  "manifest_version": 3,
  "name": "Instagram & TikTok Comments Exporter",
  "version": "0.3.1",
  "description": "Экспорт автора, описания и иерархии комментариев Instagram Reel и TikTok в Markdown.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Экспорт комментариев Instagram и TikTok",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "report.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tiktok.com/*",
        "https://www.tiktok.com/*",
        "https://m.tiktok.com/*"
      ],
      "js": [
        "report.js",
        "tiktok.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://m.tiktok.com/*"
  ]
}
